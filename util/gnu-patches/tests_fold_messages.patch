Index: gnu/tests/fold/fold.pl
===================================================================
--- gnu.orig/tests/fold/fold.pl
+++ gnu/tests/fold/fold.pl
@@ -70,7 +70,7 @@
 if ($mb_locale ne 'C')
   {
     # Duplicate each test vector, appending "-mb" to the test name and
-    # inserting {ENV => "LC_ALL=$mb_locale"} in the copy, so that we
+    # inserting {ENV => "LC_CTYPE=$mb_locale LC_MESSAGES=C"}, {ENV_DEL => "LC_ALL"} in the copy, so that we
     # provide coverage for multi-byte code paths.
     my @new;

@@ -79,7 +79,7 @@
         my @new_t = @$t;
