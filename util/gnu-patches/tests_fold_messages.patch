       }
     push @Tests, @new;

@@ -88,7 +88,7 @@
       {
         my @new_t = @$t;

-        push @new, [@new_t, {ENV => "LC_ALL=$mb_locale"}];
+        push @new, [@new_t, {ENV => "LC_CTYPE=$mb_locale LC_MESSAGES=C"}, {ENV_DEL => "LC_ALL"}];
       }
